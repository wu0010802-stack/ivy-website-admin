WEBSITE_ENVIRONMENT=development
WEBSITE_DATABASE_URL=postgresql+asyncpg://localhost/ivy_website_dev
WEBSITE_TEST_DATABASE_URL=postgresql+asyncpg://localhost/ivy_website_test
WEBSITE_MEDIA_ROOT=./var/media
WEBSITE_SESSION_SECRET=change-me-generate-a-random-32-byte-value
WEBSITE_ENABLE_FIXTURE=true
WEBSITE_INDEXING_ENABLED=false
# Google 登入為選用功能；三項都留空時維持帳密登入。
# Secret 只由安全環境變數或部署平台 Secrets 注入，勿填入版控。
WEBSITE_GOOGLE_CLIENT_ID=
WEBSITE_GOOGLE_CLIENT_SECRET=
WEBSITE_GOOGLE_REDIRECT_URI=
# LINE 登入為選用功能；三項都留空時不顯示 LINE 入口。管理員需先登入後在「我的帳號」綁定。
# Channel secret 只由安全環境變數或部署平台 Secrets 注入，勿填入版控。
WEBSITE_LINE_CHANNEL_ID=
WEBSITE_LINE_CHANNEL_SECRET=
WEBSITE_LINE_REDIRECT_URI=
# LINE 群組推播（官方帳號 Messaging API）為選用功能；兩項都留空時不推播。
WEBSITE_LINE_MESSAGING_CHANNEL_SECRET=
WEBSITE_LINE_MESSAGING_ACCESS_TOKEN=
# API 內建定期工作（排程發布、逾期占位、通知）；本機預設關閉，要測時設 60。
# WEBSITE_BACKGROUND_JOBS_INTERVAL_SECONDS=60
# 素材儲存：local（預設，WEBSITE_MEDIA_ROOT）或 s3（Cloudflare R2、AWS S3…）。
# WEBSITE_MEDIA_STORAGE=s3
# WEBSITE_S3_BUCKET=
# WEBSITE_S3_ENDPOINT_URL=https://<account id>.r2.cloudflarestorage.com
# WEBSITE_S3_REGION=auto
# WEBSITE_S3_ACCESS_KEY_ID=
# WEBSITE_S3_SECRET_ACCESS_KEY=
