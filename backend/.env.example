WEBSITE_ENVIRONMENT=development
WEBSITE_DATABASE_URL=postgresql+asyncpg://localhost/ivy_website_dev
WEBSITE_TEST_DATABASE_URL=postgresql+asyncpg://localhost/ivy_website_test
WEBSITE_MEDIA_ROOT=./var/media
# 本機可以沿用；production 會拒絕含 change-me／changeme／example／placeholder 的值，
# 請用 `python3 -c "import secrets;print(secrets.token_urlsafe(32))"` 產生。
WEBSITE_SESSION_SECRET=change-me-generate-a-random-32-byte-value
WEBSITE_ENABLE_FIXTURE=true
WEBSITE_INDEXING_ENABLED=false
# Google 登入為選用功能；三項都留空時維持帳密登入。
# Secret 只由安全環境變數或部署平台 Secrets 注入，勿填入版控。
WEBSITE_GOOGLE_CLIENT_ID=
WEBSITE_GOOGLE_CLIENT_SECRET=
WEBSITE_GOOGLE_REDIRECT_URI=
# LINE 群組推播（官方帳號 Messaging API）為選用功能；兩項都留空時不推播。
WEBSITE_LINE_MESSAGING_CHANNEL_SECRET=
WEBSITE_LINE_MESSAGING_ACCESS_TOKEN=
# API 內建定期工作（排程發布、逾期占位、通知）；本機預設關閉，要測時設 60。
# WEBSITE_BACKGROUND_JOBS_INTERVAL_SECONDS=60
# 素材儲存：local（預設，WEBSITE_MEDIA_ROOT）或 s3（Cloudflare R2、AWS S3…）。
# WEBSITE_MEDIA_STORAGE=s3
# WEBSITE_S3_BUCKET=
# WEBSITE_S3_ENDPOINT_URL=https://<account id>.r2.cloudflarestorage.com
# WEBSITE_S3_REGION=auto
# WEBSITE_S3_ACCESS_KEY_ID=
# WEBSITE_S3_SECRET_ACCESS_KEY=
# 素材單檔上限（MB，預設圖片 15、影片 150）；web 的 NUXT_MEDIA_MAX_UPLOAD_MB 要設成兩者較大的值。
# WEBSITE_MEDIA_MAX_IMAGE_MB=15
# WEBSITE_MEDIA_MAX_VIDEO_MB=150
# 刪除的素材保留幾天才由定期工作真的刪檔（期間可復原），預設 7。
# WEBSITE_MEDIA_PURGE_DELAY_DAYS=7
# LINE 登入為選用功能；三項都留空時不顯示 LINE 入口。管理員需先登入後在「我的帳號」綁定。
# Channel secret 只由安全環境變數或部署平台 Secrets 注入，勿填入版控。
WEBSITE_LINE_CHANNEL_ID=
WEBSITE_LINE_CHANNEL_SECRET=
WEBSITE_LINE_REDIRECT_URI=
# Google／LINE 登入的 redirect_uri 網域要與這個同源（後台網址）。
# production 必填，且必須是不含路徑的 https:// 網址，否則 API 拒絕啟動。
# WEBSITE_ADMIN_ORIGIN=https://web-production-04caa.up.railway.app
# 真實寄信（SMTP）；不設定就只寫本機 sink 檔／站內通知。HOST 一設就要求 FROM；
# production 不允許 starttls/ssl 以外的值。
# WEBSITE_SMTP_HOST=smtp.example.org
# WEBSITE_SMTP_PORT=587
# WEBSITE_SMTP_SECURITY=starttls
# WEBSITE_SMTP_USERNAME=
# WEBSITE_SMTP_PASSWORD=
# WEBSITE_SMTP_FROM=常春藤官網 <noreply@example.org>
# 個資保存政策的手動清理與定期自動清理共用這個開關，預設關閉（只能 dry-run）。
# WEBSITE_RETENTION_ALLOW_REAL_RUN=true
# 公開端點限流信任的訪客 IP header；只有 api 不直接對外時才可信任，見 deploy/README.md。
# WEBSITE_TRUSTED_CLIENT_IP_HEADER=x-website-client-ip
# --- 2026-09-29 資安稽核修正新增的設定（全部選填，括號內為預設） ---
# migration 專用連線（schema owner）；設定後 WEBSITE_DATABASE_URL 可改成只有 DML 權限的
# 執行期角色（見 deploy/README.md）。留空＝沿用 WEBSITE_DATABASE_URL。test 環境一律用測試庫。
# WEBSITE_MIGRATION_DATABASE_URL=postgresql+asyncpg://website_owner@localhost/ivy_website_dev
# 請求用連線池大小（10）、溢出（10）、取連線最多等幾秒（10）。限流另有固定的小池（2＋3，等 3 秒）。
# WEBSITE_DB_POOL_SIZE=10
# WEBSITE_DB_MAX_OVERFLOW=10
# WEBSITE_DB_POOL_TIMEOUT_SECONDS=10
# 每條執行期連線的 lock_timeout（10000 毫秒）與 idle_in_transaction_session_timeout
# （300000 毫秒）；0＝不設、沿用 DB 預設。alembic migration 不套用這兩個值。
# WEBSITE_DB_LOCK_TIMEOUT_MS=10000
# WEBSITE_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=300000
# 後台 session 閒置多久失效（120 分鐘，可設 5–720；有活動會自動延長，登入滿 12 小時
# 一律失效）。session cookie 不帶 Max-Age，關掉瀏覽器就清掉。
# 密碼登入：同一帳號 5 分鐘內錯 10 次，該帳號的密碼登入暫停 15 分鐘（連正確密碼也擋），
# Google／LINE 登入與已登入的 session 不受影響。這組數字寫在程式裡，沒有環境變數。
# WEBSITE_SESSION_IDLE_MINUTES=120
# Cloudflare Turnstile（公開預約的機器人驗證）：兩個都設才啟用，只設一個會拒絕啟動。
# 要等官網的 Turnstile 元件上線後才能設，順序反過來所有官網送單都會被擋（400）。
# Secret 只放部署平台 Secrets，勿填入版控。
# WEBSITE_TURNSTILE_SITE_KEY=
# WEBSITE_TURNSTILE_SECRET_KEY=
# 公開預約濫用上限：每個來源 24 小時內可占的時段數（5，只算時段模式）、每校每小時
# 官網送單件數（30，所有模式）。每來源上限靠 WEBSITE_TRUSTED_CLIENT_IP_HEADER 與代理帶的
# x-website-client-ip 分辨來源（IPv6 以 /64 計）；代理沒帶這個 header 時不套用。
# WEBSITE_BOOKING_SLOT_HOLDS_PER_SOURCE_PER_DAY=5
# WEBSITE_BOOKING_SUBMISSIONS_PER_CAMPUS_PER_HOUR=30
# 公開 telemetry／CTA 點擊的全站上限（資料不清除，超過就安靜丟棄）：
# 每分鐘（600／120）與每日（20000／5000）。
# WEBSITE_TELEMETRY_GLOBAL_PER_MINUTE=600
# WEBSITE_TELEMETRY_DAILY_CAP=20000
# WEBSITE_ANALYTICS_CLICKS_GLOBAL_PER_MINUTE=120
# WEBSITE_ANALYTICS_CLICKS_DAILY_CAP=5000
