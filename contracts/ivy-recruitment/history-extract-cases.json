          "3": [null, null, "註冊\n人數", null, "在籍     人數", "預繳人數", "註冊\n人數", "註冊率", "目標人數", "參觀人數", "預繳人數", "預繳率", "註冊人數", "參觀註冊率", "預繳人數", "註冊人數", "註冊率"],
